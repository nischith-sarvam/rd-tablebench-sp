            "content": "<table><tr><th>\u00ab03\u00bb \u0434\u0435\u043a\u0430\u0431\u0440\u044f 2020</th><th colspan=\"2\">\u0433\u043e\u0434\u0430</th></tr><tr><td colspan=\"3\">\u041f\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0438:</td></tr><tr><td>\u041a\u0438\u043c \u041c.\u0413.</td><td>- \u0434\u0438\u0440\u0435\u043a\u0442\u043e\u0440 \u043f\u043e \u0437\u0430\u043a\u0443\u043f\u043a\u0430\u043c</td><td>- \u2022 \u043f\u0440\u0435\u0434\u0441\u0435\u0434\u0430\u0442\u0435\u043b\u044c \u043a\u043e\u043c\u0438\u0441\u0441\u0438\u0438</td></tr><tr><td>\u041e\u0431\u0438\u0434\u0438\u043d\u0430 \u0415.\u0410.</td><td>- \u043d\u0430\u0447\u0430\u043b\u044c\u043d\u0438\u043a \u043e\u0442\u0434\u0435\u043b\u0430 \u043f\u0440\u0430\u0432\u043e\u0432\u043e\u0433\u043e \u0441\u043e\u043f\u0440\u043e\u0432\u043e...</td><td>- \u00b7 \u0437\u0430\u043c\u0435\u0441\u0442\u0438\u0442\u0435\u043b\u044c \u043f\u0440\u0435\u0434\u0441\u0435\u0434\u0430\u0442\u0435\u043b\u044f \u043a\u043e\u043c\u0438\u0441\u0441\u0438\u0438</td></tr><tr><td>\u041a\u043e\u0448\u0435\u043b\u0435\u0432\u0430 \u041e.\u0412.</td><td>- \u0437\u0430\u043c\u0435\u0441\u0442\u0438\u0442\u0435\u043b\u044c \u043d\u0430\u0447\u0430\u043b\u044c\u043d\u0438\u043a\u0430 \u0441\u043b\u0443\u0436\u0431\u044b \u043f\u043e ...</td><td>- \u0447\u043b\u0435\u043d \u043a\u043e\u043c\u0418\u0421\u0421\u0418\u0418</td></tr><tr><td>\u041c\u0438\u0442\u0440\u043e\u0444\u0430\u043d\u043e\u0432 \u0418.\u0410.</td><td>- \u043d\u0430\u0447\u0430\u043b\u044c\u043d\u0438\u043a \u0441\u043b\u0443\u0436\u0431\u044b \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0440\u0438\u0441\u043a...</td><td>- \u0447\u043b\u0435\u043d \u043a\u043e\u043c\u0438\u0441\u0441\u0438\u0438</td></tr><tr><td>\u041c\u0438\u0445\u0430\u043b\u0435\u0432 A.B.</td><td>- \u0438.\u043e. \u043d\u0430\u0447\u0430\u043b\u044c\u043d\u0438\u043a\u0430 \u043e\u0442\u0434\u0435\u043b\u0430 \u0431\u0435\u0437\u043e\u